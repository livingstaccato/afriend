@startuml run-flow
' Activity flow of `afriend run --mode report`, traced against
' src/afriend/commands/run.py.
' The <<downgrade>> class marks a recorded downgrade, which is visible in
' run.json and report.md.

' Theme: colours sampled from docs/images/brand/afriend-logo-512.png.
' Avenir Next and SF Mono ship with macOS and are absent from the CI runner,
' which only checks that a source renders -- the committed PNG and SVG pair
' is produced by `make diagrams` on a machine that has them.

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Avenir Next"
skinparam defaultMonospacedFontName "SF Mono"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #6E8288
skinparam ArrowFontColor #5B7079
skinparam ArrowFontSize 12
skinparam TitleFontSize 19
skinparam TitleFontColor #2D424E
skinparam legendBackgroundColor #F8FCFC
skinparam legendBorderColor #A8C3CC
skinparam legendFontSize 12
skinparam noteBackgroundColor #F4F1E8
skinparam noteBorderColor #B3AA97
skinparam noteFontColor #4A4436
skinparam noteFontSize 12
skinparam ActivityBorderColor #7E99A3
skinparam ActivityBackgroundColor #EAF3F4
skinparam ActivityFontColor #2D424E
skinparam ActivityBorderThickness 1
skinparam ActivityDiamondBackgroundColor #E7F9F8
skinparam ActivityDiamondBorderColor #4F7981
skinparam ActivityDiamondFontColor #2D424E
skinparam ActivityDiamondFontSize 12
skinparam PartitionBorderColor #A8C3CC
skinparam PartitionBackgroundColor #F8FCFC
skinparam PartitionFontColor #4F7981

' Semantic fills are <style> classes, not the `#RRGGBB:label;` prefix --
' PlantUML 1.2026.8 cannot close a partition or repeat group anywhere near
' an inline-coloured activity, and fails the whole source with "Cannot find
' group". One property per line: `{ BackgroundColor #A  LineColor #B }`
' parses as a single malformed value and the class is dropped in silence,
' leaving the tagged nodes unstyled in a diagram that still "succeeds".
<style>
.downgrade {
  BackgroundColor #F6E7C8
  LineColor #C79B4E
}
.failed {
  BackgroundColor #F3D7D2
  LineColor #C07A6E
}
.success {
  BackgroundColor #D9E8D5
  LineColor #7A9B72
}
.command {
  BackgroundColor #D8EDEC
  LineColor #4F7981
}
</style>

title afriend run --mode report

legend top right
  <color:#C79B4E>██</color>  recorded downgrade
  <color:#C07A6E>██</color>  friend failed
  <color:#7A9B72>██</color>  success
endlegend

start

partition "Resolve the roster" {
  :validate ""--mode"" / ""--preset""\nload bundled adapter records,
  provider defaults, and scoped authority grants;
  :detect host; Codex is included by default,\nother hosts excluded unless overridden;
  if (""--friend"" given?) then (yes)
    :specs from flags\n(replaces discovery entirely),\nthen preflight each named provider;
  else (no)
    :apply persistent and per-run\nenable / disable / model policy;
    :assess each provider: ready,\nunconfigured, unavailable, disabled,\nhost-excluded, or policy-blocked;
    :discover only ready providers\nround-robin a lens to each;
  endif
  :for each provider, enforce deny-by-default\nexternal-tool policy or require its\nexplicit scoped grant;
  :mark the current host harness advisory\nand independent=false;
  :an explicitly selected fresh host-provider\nworker remains independent but is disclosed;
  if (any friends?) then (no)
    :exit 3 — no usable friends;
    stop
  endif
  if (""report"" mode?) then (yes)
    if (exactly one resolved friend?) then (yes)
      :report: record one-friend downgrade; <<downgrade>>
    endif
  else (judging)
    :project selected qualification policy\n(default: two provider families);
    if (policy not satisfied?) then (yes)
      :judging mode: exit 3 before run directory;
      stop
    endif
  endif
}

partition "Prepare" {
  :install SIGINT/SIGTERM handlers;
  :resolve repository context:\nautomatic repo scope only when the artifact's resolved final target is inside the invocation repository;\nexplicit ""--repo"" = named Git worktree root;
  :create run dir, copy + hash artifact;
  if (explicit repository selected?) then (yes)
    :snapshot named repository root;\nfreeze artifact independently\n(not Git-blob-bound);
  else (automatic)
    if (resolved final target is inside invocation repository?) then (yes)
      :snapshot artifact-derived repository;\nartifact is Git-blob-bound;
    else (no)
      :force all friends to doc scope\n(no repository snapshot minted)\nand warn on stderr before dispatch; <<downgrade>>
    endif
  endif
  :per friend: build its OWN prompt from\nits OWN lens, write round-1/<friend>.prompt\n(missing lens → generic prompt, downgrade); <<downgrade>>
}

partition "Dispatch — parallel, one thread per friend" {
  if (effective friend scope is repo?) then (yes)
    :private git worktree from\nthe shared snapshot;
  else (doc)
    :artifact-only directory;
  endif
  :validate and stage digest-pinned adapter\nworkspace assets inside this isolation dir;
  note right
    Antigravity's staged reviewer is defense in depth.
    It does not prove provider-managed tools
    are disabled, so Antigravity still needs a scoped
    explicit authority grant.
  end note
  :re-enforce this provider's authority at dispatch;
  :build argv and filtered child environment;
  :probe the OS confinement mechanism\nBEFORE screening the argv;
  if (mechanism available?) then (yes)
    :apply adapter read-only controls and,\nwhere declared, an outer read-only OS\npolicy; Codex uses the outer policy because\nmacOS command sandboxes cannot nest; Linux\nbwrap exposes a safe resolver target\nread-only when /etc/resolv.conf resolves outside /etc;
  else (no)
    :drop any flag justified only by that policy\n(Codex ""--sandbox danger-full-access""),\nkeeping the rest of readonly_argv; <<downgrade>>
    :withdraw readonly where the sandbox WAS\nthe write protection; record the downgrade; <<downgrade>>
  endif
  :capability = the declared, enforced\ncontrols — never re-derived from scope;
  :spawn in its own process group\ndeadline = ""--timeout"" + 60s grace;
  if (timed out / aborted?) then (yes)
    :SIGTERM the group, then SIGKILL; <<failed>>
  else (no)
    :unwrap the CLI's JSON envelope,\nstrip ANSI, extract JSON, validate;
    if (usable payload?) then (yes)
      :emit claims;
    else (no)
      :mark failed, keep stderr tail; <<failed>>
    endif
  endif
}

partition "Merge & report" {
  :tear down every worktree and isolation dir;
  :write <friend>.raw / .meta / .err / .sandbox\nwith authority, staging, and confinement evidence;
  :exact-merge claims: identical claims become\naliases, origins accumulate as corroboration;
  :append every claim AND alias to claims.jsonl;
  :write run.json + report.md, print the run dir;
}

if (any friend usable?) then (yes)
  :exit 0; <<success>>
else (no)
  :exit 1 — run incomplete; <<failed>>
endif

stop

@enduml
