@startuml gate-workflow
' The gate loop: run, resolve, re-check. Traced against
' src/afriend/commands/run.py (cmd_run's gate branch),
' commands/resolve.py, and resolutions.py.

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #37474F
skinparam ArrowFontSize 11
skinparam TitleFontSize 18

skinparam activity {
  BorderColor #546E7A
  BackgroundColor #ECEFF1
  DiamondBorderColor #546E7A
  DiamondBackgroundColor #ECEFF1
  FontSize 13
  DiamondFontSize 12
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
  FontSize 12
}

title The gate loop

start

#E3F2FD:afriend run spec.md "--mode gate";
:critique, then cross-examine;

if (any non-advisory claim\nnot cleared by its state?) then (no)
  #C8E6C9:exit 0 — gate clear;
  stop
else (yes)
endif

#FFCDD2:exit 1 — names each blocking claim;

note right
  Only settled-refuted clears on its
  own. superseded is exempt because its
  successor carries the question.
  discarded and incomplete both need a
  Resolution: no working assessment is
  not a pass.
end note

repeat
  :a human changes something;
  #E3F2FD:afriend resolve RUN_ID\nclaim = c-0001@1\ndisposition = fixed\nevidence = src/auth.py:38;

  if (evidence names a location?) then (no)
    #FFCDD2:exit 2 — refused;
    stop
  else (yes)
  endif

  :compare that location against\nthe run's frozen copy or snapshot;

  if (fixed, but nothing changed there?) then (yes)
    #FFCDD2:exit 2 — refused;
    stop
  else (no)
  endif

  :append resolution\nverified = changed | unchanged | unverifiable;
repeat while (claims still blocking?) is (yes) not (no)

#C8E6C9:exit 0 — gate clear;
stop

@enduml
